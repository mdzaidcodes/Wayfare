{
  "name": "wayfare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "next typegen && tsc --noEmit",
    "smoke": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/smoke.mts",
    "plan": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/plan.mts",
    "db:setup": "tsx --env-file-if-exists=.env.local scripts/db-setup.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "^0.21.0",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "framer-motion": "^14.6.0",
    "next": "16.4.3",
    "openai": "^7.43.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
