# Copy to .env.local and fill in. The app starts with whatever keys are present.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=medium
# Optional per-agent overrides, e.g.:
# OPENAI_REASONING_EFFORT_ITINERARY=high

APIFY_TOKEN=
GOOGLE_MAPS_API_KEY=
VIATOR_API_KEY=
# Sandbox keys only work against the sandbox API:
# VIATOR_API_BASE=https://api.sandbox.viator.com/partner

# PostgreSQL for saved trips. Leave empty to keep trips in the browser only.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE  (then run: npm run db:setup)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/wayfare

MAX_TOKENS_PER_PLAN=400000
MAX_PROVIDER_CALLS_PER_PLAN=60

# Itinerary buffers in minutes
# AIRPORT_BUFFER_INTERNATIONAL_MIN=180
# AIRPORT_BUFFER_DOMESTIC_MIN=120
# ARRIVAL_BUFFER_INTERNATIONAL_MIN=60
# ARRIVAL_BUFFER_DOMESTIC_MIN=30

# Never enable outside local testing; shows a DEMO DATA banner.
ALLOW_DEMO_DATA=false

# Optional
# APIFY_FLIGHTS_ACTOR=lergassy/google-flights-api
# APIFY_HOTELS_ACTOR=benthepythondev/google-hotels-scraper
# KIWI_MCP_URL=https://mcp.kiwi.com
# FRANKFURTER_URL=https://api.frankfurter.dev/v2
# EVIDENCE_SIGNING_SECRET=   (default: generated once into .data/evidence-secret)
# RATE_LIMIT_PER_MINUTE=20
# MAX_CONCURRENT_PLANS=4
# OPENAI_AGENTS_TRACING=false   (true sends agent traces to the OpenAI dashboard)
